# Copy to .env and edit. Never commit .env, secrets/ or data/.

# Public hostname served by Nginx. For Let's Encrypt it must resolve to this server.
APP_DOMAIN=localhost
# Contact address for Let's Encrypt expiry notices (letsencrypt mode only).
LETSENCRYPT_EMAIL=
# Set to 1 to rehearse against Let's Encrypt's staging CA (no rate limits, browsers won't trust it).
# LETSENCRYPT_STAGING=

# Host ports for Nginx. Change them only for local runs where 80/443 are taken.
HTTP_PORT=80
HTTPS_PORT=443

# App
APP_ENV=production
LOG_LEVEL=INFO
# Set by scripts/deploy.sh. Shown at GET /
APP_VERSION=dev

# Image. Builds locally by default. In production point API_IMAGE at your registry, for
# example ghcr.io/<owner>/<repo>/notes-api (lowercase), which is where the deploy workflow
# pushes. scripts/deploy.sh sets API_TAG and APP_VERSION after each successful release.
API_IMAGE=notes-api
API_TAG=local

# Database. The password is not here: scripts/gen-secrets.sh writes secrets/db_password.
DB_NAME=notes
DB_USER=notes

# Host directory that node-exporter reads for backup and restore-drill metrics.
METRICS_TEXTFILE_DIR=/var/lib/node-exporter-textfile

# Optional, read by scripts/backup.sh (the defaults are fine for a single server).
# BACKUP_DIR=/var/backups/notes-stack
# BACKUP_RETENTION_DAYS=14
# rclone destination for off-site copies, for example s3remote:my-bucket/notes-stack
# BACKUP_REMOTE=
